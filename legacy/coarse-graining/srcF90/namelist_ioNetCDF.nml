!-----------------------------------------------------------------------
&rdnc_param           !   Input netCDF
!-----------------------------------------------------------------------
    indir = "../nemo-results/data_R27/100-102y/"  
   trcnam = "GYRE_5d_00010101_00021230_grid_T.nc"
   uncnam = "GYRE_5d_00010101_00021230_grid_U.nc"
   vncnam = "GYRE_5d_00010101_00021230_grid_V.nc"
   wncnam = "GYRE_5d_00010101_00021230_grid_W.nc"  
   sshnam = "GYRE_5d_00010101_00021230_grid_T.nc"
    dmdir = "../nemo-base/base-config/domain-config/"
   dmgrid = "domain_cfg"
/
!-----------------------------------------------------------------------
&dim_param            !   netCDF dimension names 
!-----------------------------------------------------------------------
     nm_x = "x"
     nm_y = "y"
    nm_z1 = "depth"
    nm_z2 = "nav_lev"
     nm_t = "time_counter"
/
!-----------------------------------------------------------------------
&wrnc_param           !   Output netCDF
!-----------------------------------------------------------------------
